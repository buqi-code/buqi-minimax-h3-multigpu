{
  "unet": {
    "class_type": "MiniMaxH3SPUNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_fl2va_pruned_fp8_scaled.safetensors",
      "weight_dtype": "default",
      "world_size": 2,
      "devices": "auto"
    }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "default"
    }
  },
  "vae_video": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_video_vae_fp16.safetensors" }
  },
  "vae_audio": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" }
  },
  "loadimage": {
    "class_type": "LoadImage",
    "inputs": { "image": "your_first_frame.png" }
  },
  "i2v": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": ["clip", 0],
      "vae": ["vae_video", 0],
      "prompt": "Describe the scene, motion, dialogue and sound here.",
      "width": 832,
      "height": 480,
      "length": 124,
      "first_frame": ["loadimage", 0]
    }
  },
  "guider": {
    "class_type": "BasicGuider",
    "inputs": { "model": ["unet", 0], "conditioning": ["i2v", 0] }
  },
  "noise": {
    "class_type": "RandomNoise",
    "inputs": { "noise_seed": 42424242 }
  },
  "sampler": {
    "class_type": "KSamplerSelect",
    "inputs": { "sampler_name": "res_multistep" }
  },
  "scheduler": {
    "class_type": "BasicScheduler",
    "inputs": { "model": ["unet", 0], "scheduler": "simple", "steps": 20, "denoise": 1.0 }
  },
  "custom": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["noise", 0],
      "guider": ["guider", 0],
      "sampler": ["sampler", 0],
      "sigmas": ["scheduler", 0],
      "latent_image": ["i2v", 1]
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["custom", 0], "vae": ["vae_video", 0] }
  },
  "decode_audio": {
    "class_type": "VAEDecodeAudio",
    "inputs": { "samples": ["custom", 0], "vae": ["vae_audio", 0] }
  },
  "createvideo": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["decode", 0],
      "audio": ["decode_audio", 0],
      "fps": 24.0,
      "bit_depth": 8
    }
  },
  "save": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["createvideo", 0],
      "filename_prefix": "video/h3_multigpu",
      "format": "auto",
      "codec": "auto"
    }
  }
}
